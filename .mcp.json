{
  "mcpServers": {
    "claude-flow": {
      "command": "npx",
      "args": ["-y", "ruflo@3.44.0", "mcp", "start"],
      "env": {
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "8",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      }
    },
    "playwright": {
      "command": "node",
      "args": ["scripts/mcp-playwright.js"]
    }
  }
}
