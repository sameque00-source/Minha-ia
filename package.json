{
  "name": "minhaia",
  "version": "0.1.0",
  "private": true,
  "description": "MinhaIA — sistema de agentes construído sobre a infraestrutura MASTER (CLAUDE-MESTRE-FINAL-SKILLS-EM-LOTES-COMPLETO), consumida somente leitura.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bin": {
    "minhaia": "bin/minhaia.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node bin/minhaia.js sync",
    "verify": "node bin/minhaia.js verify",
    "doctor": "node bin/minhaia.js doctor",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:master": "node bin/minhaia.js test-master",
    "pretest": "node bin/minhaia.js sync",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
